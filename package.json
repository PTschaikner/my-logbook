{
  "name": "my-logbook",
  "version": "1.0.0",
  "private": true,
  "description": "A hosted climbing log \u2014 Cloudflare Pages + D1.",
  "scripts": {
    "db:create": "wrangler d1 create mylogbook",
    "db:schema": "wrangler d1 execute mylogbook --file=./schema.sql --remote",
    "db:seed": "wrangler d1 execute mylogbook --file=./seed-data.sql --remote",
    "dev": "wrangler pages dev public",
    "deploy": "wrangler pages deploy public"
  },
  "devDependencies": {
    "wrangler": "^3.90.0"
  }
}